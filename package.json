{
  "name": "uusd-arb-bot",
  "version": "1.0.0",
  "description": "UUSD peg maintenance bot - maintains UUSD price stability via Curve pool arbitrage",
  "author": "Ubiquity DAO",
  "license": "MIT",
  "main": "src/action.ts",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "npx tsx src/action.ts",
    "start:dry-run": "EXECUTE_ENABLED=false npx tsx src/action.ts",
    "start:curve": "STRATEGY_MODE=curve-swap npx tsx src/action.ts",
    "start:ubiquity": "STRATEGY_MODE=ubiquity-pool npx tsx src/action.ts",
    "cli": "npx tsx cli.ts",
    "cli:execute": "npx tsx cli.ts -- --execute",
    "cli:backtest": "npx tsx cli.ts -- --backtest",
    "build": "tsc --project tsconfig.json",
    "format": "run-p format:*",
    "format:lint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format:cspell": "cspell **/*",
    "knip": "knip --config .github/knip.ts",
    "knip-ci": "knip --no-exit-code --reporter json --config .github/knip.ts",
    "test": "jest --setupFiles dotenv/config --coverage",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:anvil": "anvil --host 127.0.0.1 --port 8545 --fork-url https://rpc.ubq.fi/1 --chain-id 1",
    "prepare": "husky"
  },
  "keywords": [
    "typescript",
    "uusd",
    "arbitrage",
    "stablecoin",
    "peg-maintenance",
    "curve",
    "defi",
    "dao",
    "ubiquity"
  ],
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "@ubiquity-os/ubiquity-os-logger": "^1.4.0",
    "dotenv": "17.2.3",
    "viem": "^2.40.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@cspell/dict-node": "5.0.8",
    "@cspell/dict-software-terms": "5.1.13",
    "@cspell/dict-typescript": "3.2.3",
    "@eslint/js": "9.39.1",
    "@jest/globals": "30.2.0",
    "@mswjs/data": "0.16.2",
    "@swc/core": "^1.15.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.1",
    "@ubiquity-os/eslint-plugin-no-empty-strings": "^1.0.3",
    "cspell": "9.3.2",
    "eslint": "9.39.1",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-sonarjs": "3.0.5",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "16.0.0",
    "jest-md-dashboard": "0.8.1",
    "knip": "5.69.1",
    "lint-staged": "16.2.6",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**.{ts,json}": [
      "cspell"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
